; MC spreads a section over as many fragments as its size requires, so a
; .debug_str larger than a single fragment has to be captured in full when the
; object is round-tripped through the CAS.

; REQUIRES: aarch64-registered-target
; RUN: rm -rf %t && mkdir -p %t
; RUN: llc --filetype=obj --cas-backend --cas=%t/cas --mccas-verify \
; RUN:     --mtriple=arm64-apple-macosx15.0 %s -o %t/debug-str-multi-fragment.o \
; RUN:     2>&1 | FileCheck %s --allow-empty
; CHECK-NOT: CASBackend output round-trip verification error

target triple = "arm64-apple-macosx15.0"

@g = global i32 1, align 4, !dbg !0

!llvm.dbg.cu = !{!2}
!llvm.module.flags = !{!6, !7}

!0 = !DIGlobalVariableExpression(var: !1, expr: !DIExpression())
!1 = distinct !DIGlobalVariable(name: "g_", scope: !2, file: !3, line: 1, type: !5, isLocal: false, isDefinition: true)
!2 = distinct !DICompileUnit(language: DW_LANG_C11, file: !3, producer: "clang", emissionKind: FullDebug, globals: !4, nameTableKind: Apple)
!3 = !DIFile(filename: "debug-str-multi-fragment.c", directory: "/tmp")
!4 = !{!0}
!5 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
!6 = !{i32 7, !"Dwarf Version", i32 5}
!7 = !{i32 2, !"Debug Info Version", i32 3}
